# Dhwani AI Backend Environment Variables
# Optional server-side fallback API key (public users supply their own keys in browser BYOK)
GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional CORS origin for production (e.g. your deployed Netlify frontend URL)
# FRONTEND_URL=https://your-dhwani-site.netlify.app

# Server Port & Host (Render automatically assigns PORT)
PORT=5000
HOST=0.0.0.0